# /etc/societybooks/api.env
#
# Owned by root, group the service user, mode 0640. This file holds the
# database password: it does not belong in the repository, in the unit file, or
# in a directory the web server can serve.
#
#   sudo install -o root -g societybooks -m 0640 this-file /etc/societybooks/api.env
#   sudo systemctl restart societybooks-api
#
# systemd reads this literally: no quotes, no shell expansion, one KEY=VALUE
# per line. A '#' starts a comment only at the beginning of a line.

# --- the database ----------------------------------------------------------
# The pooled endpoint for the application, the direct one for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-123456-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx-123456.REGION.aws.neon.tech/DBNAME?sslmode=verify-full

# --- secrets ---------------------------------------------------------------
# openssl rand -hex 32
SESSION_SECRET=

# --- the site --------------------------------------------------------------
# The one origin allowed to call the API with cookies.
ALLOWED_ORIGIN=https://books.example.org
SECURE_COOKIES=true

# --- email -----------------------------------------------------------------
# smtp sends; none sends nothing and says so. local-dev is refused in
# production, because it writes messages to the log instead of sending them.
EMAIL_PROVIDER=none
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=books@example.org
# SMTP_FROM_NAME=Your Association

# SMTP_REQUIRE_TLS=true
# SMTP_IMPLICIT_TLS=

# --- one-time sign-in codes ------------------------------------------------
# 'email' sends codes through SMTP above, and needs EMAIL_PROVIDER=smtp.
# 'none' makes the server decline to issue codes; members then need a
# password set by the secretary. No SMS provider is implemented.
OTP_PROVIDER=none
# OTP_PROVIDER=email

# --- operations ------------------------------------------------------------
LOG_LEVEL=info
# nginx in front sets X-Forwarded-For to the caller; without this every
# request seems to come from nginx and one person can lock out sign-in.
TRUST_PROXY=true
DB_POOL_MAX=8
RUN_WORKER=true

# --- first-time setup ------------------------------------------------------
# Opens the "Set up your society" screen on a database with no production
# society yet: whoever presents this token creates the society and its first
# secretary. At least 16 characters. Setup closes by itself once the society
# exists; remove the variable afterwards. Unset, use `npm run db:bootstrap`.
# SETUP_TOKEN=
