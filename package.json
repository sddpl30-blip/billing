{
  "name": "society",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3600 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --port=3600 --host=0.0.0.0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.accounting.json --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test:accounting": "node scripts/test-accounting.mjs",
    "demo:accounting": "node scripts/test-accounting.mjs demo",
    "test": "node scripts/test-accounting.mjs && node scripts/test-accounting.mjs integration && node scripts/test-accounting.mjs persistence",
    "test:integration": "node scripts/test-accounting.mjs integration",
    "test:persistence": "node scripts/test-accounting.mjs persistence",
    "build:browser": "node scripts/build-browser.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:all": "npm run test && npm run test:browser && npm run test:backend && npm run test:frontend",
    "db:migrate": "node server/migrate.mjs",
    "db:status": "node server/migrate.mjs status",
    "test:db": "node server/schema.test.mjs && node server/schema-domain.test.mjs",
    "db:verify": "node server/migrate.mjs verify",
    "test:prisma": "node scripts/check-prisma-schema.mjs",
    "server:build": "node scripts/server.mjs build",
    "server:seed": "node scripts/server.mjs seed",
    "server": "node scripts/server.mjs serve",
    "test:server": "node scripts/server.mjs test",
    "test:pg": "node scripts/server.mjs test:pg",
    "test:backend": "npm run test:prisma && npm run test:connection && npm run test:db && npm run test:pg && npm run test:documents && npm run test:security && npm run test:smtp && npm run test:wiring && npm run test:deploy && npm run test:server && npm run test:serverless && npm run test:server:serverless",
    "typecheck:stubs": "tsc -p tsconfig.check.json",
    "test:documents": "node server/documents.test.mjs",
    "test:security": "node scripts/server.mjs build && node server/security.test.mjs",
    "test:smtp": "node scripts/server.mjs build && node server/smtp.test.mjs",
    "test:wiring": "node server/wiring.test.mjs",
    "test:frontend": "node scripts/build-browser.mjs && node server/frontend.test.mjs",
    "db:check": "node scripts/server.mjs check",
    "test:connection": "node server/connection.test.mjs",
    "db:baseline": "node scripts/build-prisma-baseline.mjs",
    "db:verify-backup": "node scripts/verify-backup.mjs",
    "db:migrate:node": "node scripts/server.mjs build && node server/migrate-node.mjs",
    "db:status:node": "node scripts/server.mjs build && node server/migrate-node.mjs status",
    "test:serverless": "node scripts/server.mjs build && node server/serverless.test.mjs",
    "test:server:serverless": "node scripts/server.mjs build && SB_TEST_TRANSPORT=serverless node server/api.test.mjs",
    "test:deploy": "node scripts/server.mjs build && node server/deploy.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
