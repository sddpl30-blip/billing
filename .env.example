# SocietyBooks backend — environment template.
#
# Copy to .env and fill in. Nothing here is a real credential, and nothing in
# this file is read in production without being set: the server refuses to
# start in production with a missing or short SESSION_SECRET rather than
# falling back to a default, because a deployment that boots with a default
# signing key looks fine and is not.

# --- where it runs ---------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# The one origin allowed to call the API with cookies. A wildcard cannot be
# combined with credentials, and should not be.
ALLOWED_ORIGIN=http://localhost:3600

# --- database --------------------------------------------------------------
# Two URLs, because they are used for different things:
#
#   DATABASE_URL  the application's queries. Use the POOLED endpoint on a
#                 managed provider.
#   DIRECT_URL    migrations. Use the DIRECT endpoint: a migration takes
#                 session-level locks that a connection pooler does not hold.
#
# For Neon, both come from your project's Connection Details — with pooling
# ticked for the first and unticked for the second. See docs/NEON.md, which
# says exactly which box to copy from.
#
# Use sslmode=verify-full, not require: `require` encrypts the traffic without
# establishing who is on the other end of it. Neon's certificate is from a
# public CA, so verification works.
#
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-123456-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx-123456.REGION.aws.neon.tech/DBNAME?sslmode=verify-full"
#
# NEVER put either of these in a VITE_ variable. Those are compiled into the
# JavaScript a browser downloads. Only the API talks to the database.
#
# A local PostgreSQL over a unix socket, which is the libpq form:
#   DATABASE_URL=postgresql://societybooks@/societybooks?host=/var/run/postgresql
#
# Or the PG* variables, which take effect when DATABASE_URL is unset:
PGHOST=/var/run/postgresql
PGPORT=5432
PGUSER=societybooks
PGDATABASE=societybooks
# PGPASSWORD=
# PGSSLMODE=verify-full
# Seconds to wait for a connection. A suspended Neon compute takes a moment to
# wake on the first connection after an idle period.
# PGCONNECT_TIMEOUT=15

# Connections per process. Default 8 on a long-lived server, and 2 when
# VERCEL is set — there may be many serverless instances, and a large pool in
# each is how a database's connection limit gets spent on idle sockets.
DB_POOL_MAX=8
# The name this server shows in pg_stat_activity.
# PGAPPNAME=societybooks-api

# --- secrets ---------------------------------------------------------------
# Signs session tokens and hashes rate-limit subjects. Required in production,
# at least 32 characters. Generate one with:  openssl rand -hex 32
# Never commit the real value.
SESSION_SECRET=

# --- sessions and sign-in --------------------------------------------------
SESSION_TTL_MINUTES=720
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_LENGTH=6
LOGIN_CODE_MAX_ATTEMPTS=5
# false only for local http. Setting it false with NODE_ENV=production is
# refused at startup.
SECURE_COOKIES=false

RATE_LIMIT_LOGIN_PER_HOUR=10
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_WINDOW_MINUTES=60

# --- email -----------------------------------------------------------------
#   smtp       sends, over SMTP. Needs SMTP_HOST and SMTP_FROM below, and
#              credentials where the server requires them. This is the one
#              that delivers.
#   local-dev  writes the message to the log instead of sending it, and
#              reports `delivers: false`. Refused in production.
#   none       nothing is sent, and every response says so.
EMAIL_PROVIDER=local-dev

# The SMTP server. NOT CONNECTED until these are filled in: the client is
# written and tested, and it has nowhere to connect without a host.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587                  # 465 implies implicit TLS
# SMTP_IMPLICIT_TLS=             # true/false; overrides what the port implies
# SMTP_USER=
# SMTP_PASSWORD=                 # from a secret store, not from this file
# SMTP_FROM=books@example.org    # the envelope sender; required with smtp
# SMTP_FROM_NAME=Your Association
# SMTP_TIMEOUT_MS=20000
# Refuses to send over a connection that never became encrypted. Turning this
# off sends members' addresses and their dues in the clear, so it has to be
# deliberate.
# SMTP_REQUIRE_TLS=true

# --- one-time sign-in codes ------------------------------------------------
#   email      sends the code through the email provider above. With
#              EMAIL_PROVIDER=smtp this is how members sign in in production;
#              the server refuses to start in production with email codes and
#              no SMTP behind them.
#   local-dev  writes the code to the log instead of sending it. Refused in
#              production, deliberately.
#   none       the server declines to issue codes at all, and says so.
#
# No SMS provider is implemented; one would implement OtpProvider in
# server/src/providers/otp.ts.
OTP_PROVIDER=local-dev

# --- banking ---------------------------------------------------------------
# Statement import works from a file (CSV or MT940). There is no banking API
# connection and no credential column anywhere in the schema for one, by
# design; `payVendor` records a payment the society made, it does not instruct
# a bank to pay.

# --- operations ------------------------------------------------------------
LOG_LEVEL=info
# Reserved. Nothing reads it today: PDFs are re-rendered from what the
# database stores, so a serverless platform's ephemeral disk loses nothing.
# STORAGE_DIR=./.storage

# The background worker. Set false on a second instance if you want only one
# of them running jobs, though the scheduler is safe to run on several: it
# claims with FOR UPDATE SKIP LOCKED and every job has a unique business key.
#
# On a serverless platform there is no process for a timer to live in, and the
# adapter never starts the worker. The platform's scheduler calls
# /api/cron/run instead; see CRON_SECRET below and docs/VERCEL.md.
RUN_WORKER=true
WORKER_INTERVAL_MS=60000

# --- the scheduler, when it is an endpoint ---------------------------------
# Shared secret for /api/cron/run and /api/cron/status. The scheduler presents
# it as `Authorization: Bearer <secret>`; both endpoints refuse everything
# else, and refuse everyone while this is unset. At least 16 characters.
#
# On Vercel, setting CRON_SECRET in the project's environment variables is
# enough: the platform sends it on its own cron requests. Generate one with:
#   openssl rand -hex 32
# CRON_SECRET=

# How long one scheduled pass may keep working before it stops itself and
# leaves the rest for the next run. Keep it comfortably under the platform's
# function timeout: a pass that is killed mid-job leaves that job to be
# requeued, which costs it an attempt.
# CRON_BUDGET_MS=25000

# --- behind a proxy --------------------------------------------------------
# Whether X-Forwarded-For is believed. It decides what the login rate limiter
# counts, and both ways of getting it wrong are silent:
#
#   true   behind a proxy (Vercel, nginx, Cloudflare). Without it every caller
#          shares the proxy's address and one person guessing passwords locks
#          out the whole society.
#   false  directly on a socket. The header is then whatever the caller typed,
#          and believing it lets them rotate out of the rate-limit bucket.
#
# Unset is the right answer in both cases: it is true when VERCEL is set in the
# environment (which Vercel does for you) and false otherwise.
# TRUST_PROXY=true

# --- seeding ---------------------------------------------------------------
# Only used by `npm run server:seed`, which refuses to run with
# NODE_ENV=production.
SEED_PASSWORD=

# --- the front end ---------------------------------------------------------
# Read by Vite at build time, not by the server.
#
#   VITE_API_BASE      where the API is. Empty means the same origin as the
#                      app, which is the normal deployment.
#   VITE_DATA_SOURCE   server — require the API; an unreachable one is an error
#                      on screen. demo — never contact it, run the sample
#                      society in the browser. Unset — try, then fall back.
#
# Set VITE_DATA_SOURCE=server for anything real. Left unset, a deployment
# whose API is down quietly shows demonstration data instead.
VITE_API_BASE=
VITE_DATA_SOURCE=server
# The URL path the app is served under, e.g. /society/ on a shared site.
# PUBLIC_BASE_PATH=/

# --- first-time setup ------------------------------------------------------
# Opens the "Set up your society" screen on a database with no production
# society yet: whoever presents this token creates the society and its first
# secretary. At least 16 characters. Setup closes by itself once the society
# exists; remove the variable afterwards. Unset, use `npm run db:bootstrap`.
# SETUP_TOKEN=

# --- Sign in with Google ---------------------------------------------------
# For members whose e-mail is already on file; no sign-up. Both or neither.
# Setup: docs/GOOGLE-SIGN-IN.md. The redirect URI is ALLOWED_ORIGIN +
# /api/auth/google/callback unless GOOGLE_REDIRECT_URI says otherwise.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
