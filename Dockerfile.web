# The front end, built and served by nginx.
#
# NOT VERIFIED BY A BUILD. The machine this was written on has no reachable
# docker daemon and no npm registry, so neither this image nor the Vite build
# inside it has ever run here. It is written from the project's real layout and
# scripts; treat the first build as one that may need fixing.
#
# Two things it does that matter:
#
#  · `VITE_DATA_SOURCE=server` is baked in, so the app does not fall back to
#    demonstration data when the API cannot be reached — it says so instead. A
#    committee reading sample figures and believing them is the failure this
#    prevents.
#  · The API is served from the same origin, under /api, by the nginx config
#    below. The session cookie is SameSite=Strict, so a separate API origin
#    would mean the browser never sends it.

FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

COPY tsconfig*.json vite.config.ts index.html ./
COPY types ./types
COPY src ./src
COPY scripts ./scripts

# Empty means "this origin", which is what the nginx config serves.
ENV VITE_API_BASE=""
ENV VITE_DATA_SOURCE="server"

# Typecheck before building. A bundler will happily emit a broken app.
RUN npx tsc --noEmit && npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
